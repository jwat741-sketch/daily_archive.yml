name: Daily Wayback Archive

on:
  schedule:
    - cron: '0 0 * * *'  # This tells GitHub to run this code automatically every day at midnight!
  workflow_dispatch:      # This allows you to also trigger it manually with a button click

jobs:
  archive:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: pip install requests

    - name: Run Archive
      run: python archive.py
