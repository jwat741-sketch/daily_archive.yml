ame: Daily Wayback Archive

on:
  schedule:
    - cron: '0 0 * * *'  # Automatically executes every single day at 00:00 UTC
  workflow_dispatch:      # Allows you to trigger it manually via the Actions button on GitHub

jobs:
  archive:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Repository
      uses: actions/checkout@v3

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.10'

    - name: Install dependencies
      run: pip install requests

    - name: Run Archive
      run: python archive.py
